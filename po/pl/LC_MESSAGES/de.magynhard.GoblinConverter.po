#: src/modules/views/main_window.cr:99
msgid "A simple document converter"
msgstr "Prosty konwerter dokumentów"

#: src/modules/views/main_window.cr:116
msgid "About"
msgstr "O programie"

#: src/modules/views/conversion_mode_group.cr:12
msgid "Conversion"
msgstr "Konwersja"

#: src/modules/views/conversion_mode_group.cr:16
msgid "Mode"
msgstr "Tryb"

#: src/modules/views/conversion_mode_group.cr:20
msgid "Monochrome"
msgstr "Monochromatyczny"

#: src/modules/views/conversion_mode_group.cr:21
msgid "Grayscale"
msgstr "Skala szarości"

#: src/modules/views/conversion_mode_group.cr:22
msgid "Grayscale Quality"
msgstr "Skala szarości (jakość)"

#: src/modules/views/conversion_mode_group.cr:23
msgid "Color"
msgstr "Kolor"

#: src/modules/views/conversion_mode_group.cr:34
msgid "Threshold"
msgstr "Próg"

#: src/modules/views/conversion_mode_group.cr:35
msgid ""
"Decrease for more black.\n"
"66 is a good fit for colored docs.\n"
"For grayscaled documents 50-60 is\n"
"often a good choice."
msgstr ""
"Zmniejsz, aby uzyskać więcej czerni.\n"
"66 dobrze sprawdza się w dokumentach kolorowych.\n"
"W dokumentach w skali szarości dobre są\n"
"często wartości 50-60."

#: src/modules/views/conversion_mode_group.cr:44
msgid "Resolution"
msgstr "Rozdzielczość"

#: src/modules/views/conversion_mode_group.cr:45
msgid "Density of the resolution in dpi for your output"
msgstr "Gęstość rozdzielczości w dpi dla pliku wyjściowego"

#: src/modules/views/conversion_mode_group.cr:54
msgid "Quality"
msgstr "Jakość"

#: src/modules/views/conversion_mode_group.cr:55
msgid "Lossy compression quality"
msgstr "Jakość kompresji stratnej"

#: src/modules/views/conversion_mode_group.cr:64
msgid "Strip metadata"
msgstr "Usuń metadane"

#: src/modules/views/conversion_mode_group.cr:65
msgid "Remove metadata like EXIF, IPTC, XMP, and ICC profiles from output file"
msgstr ""
"Usuwa metadane, takie jak EXIF, IPTC, XMP i profile ICC, z pliku wyjściowego"

